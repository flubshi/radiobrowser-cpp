# Doxygen configuration. Run from the repository root:
#   mkdir -p build/docs && doxygen docs/Doxyfile
PROJECT_NAME           = "radiobrowser-cpp"
PROJECT_BRIEF          = "C++ client library for the radio-browser.info API"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
INPUT                  = README.md docs/custom-transport.md CONTRIBUTING.md CHANGELOG.md SECURITY.md include/radiobrowser
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
EXCLUDE_SYMBOLS        = detail detail::*
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = RADIOBROWSER_EXPORT= RADIOBROWSER_HAS_CURL=1
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
HAVE_DOT               = NO
SOURCE_BROWSER         = NO
STRIP_FROM_PATH        = include .
FULL_PATH_NAMES        = YES
