@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(radiobrowser_WITH_CURL @RADIOBROWSER_WITH_CURL@)
set(radiobrowser_STATIC @RADIOBROWSER_IS_STATIC@)

# A static library carries its private link dependencies.
if(radiobrowser_STATIC)
  find_dependency(Threads)
  if(radiobrowser_WITH_CURL)
    find_dependency(CURL)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/radiobrowserTargets.cmake")

check_required_components(radiobrowser)
