prefix=@CMAKE_INSTALL_PREFIX@
libdir=@RADIOBROWSER_PC_LIBDIR@
includedir=@RADIOBROWSER_PC_INCLUDEDIR@

Name: radiobrowser
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: @RADIOBROWSER_PC_REQUIRES@
Requires.private: @RADIOBROWSER_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir}@RADIOBROWSER_PC_CFLAGS@
Libs: -L${libdir} -lradiobrowser@RADIOBROWSER_PC_LIBS@
Libs.private: @RADIOBROWSER_PC_LIBS_PRIVATE@
